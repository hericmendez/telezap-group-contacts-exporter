# WhatsApp Group Exporter — environment configuration
# Copy to .env and fill values: cp .env.example .env

# Required: exact WhatsApp group name as it appears in WhatsApp
GROUP_NAME=

# Output CSV path (default: output/contacts.csv)
OUTPUT_FILE=output/contacts.csv

# Telegram MTProto (server-only — never NEXT_PUBLIC_, never committed)
# Create an application at https://my.telegram.org → API development tools.
# Required only for Telegram features (Phase 14+).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TeleZap application users (server-only, never committed).
# Format: username:hash pairs separated by ",". Generate each hash with:
#   pnpm auth:hash -- <username>
# then paste ONLY the printed hash below (never a password).
# Example: TELEZAP_USERS="revi:scrypt.16384.8.1.<saltB64url>.<hashB64url>"
# (hashes contain no "$" on purpose: Next.js expands $VAR in env values)
TELEZAP_USERS=
