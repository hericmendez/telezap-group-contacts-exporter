{
  "name": "whatsapp-group-exporter",
  "version": "0.1.0",
  "description": "Export WhatsApp and Telegram group participants to CSV via a Next.js monolith",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "tsx src/cli.ts",
    "cli:watch": "tsx watch src/cli.ts",
    "whatsapp:migrate-session": "tsx src/whatsapp/migrate-session.ts",
    "auth:hash": "tsx src/auth/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "telegram:migrate-session": "tsx src/telegram/migrate-session.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "big-integer": "^1.6.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.46.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "teleproto": "^1.229.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/big-integer": "^0.0.35",
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
